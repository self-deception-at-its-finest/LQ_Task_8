{
  "compilerOptions": {
    "types": [
      "node",
      "@wdio/globals/types",
      "webdriverio/async",
      "mocha"
    ],
    "allowImportingTsExtensions": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "test/**/*",
    "src/**/*"
  ]
}